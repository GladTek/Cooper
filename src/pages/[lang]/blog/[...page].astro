---
export const prerender = true;
import Layout from '~/layouts/Layout.astro';
import PageHeader from '~/components/layout/PageHeader.astro';
import Button from '~/components/ui/Button.astro';
import BlogCard from '~/components/blog/BlogCard.astro';
import Container from '~/components/ui/Container.astro';
import Grid from '~/components/ui/Grid.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '~/site.config';

import { languages } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';

import type { GetStaticPathsOptions, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths({ paginate }: { paginate: GetStaticPathsOptions['paginate'] }) {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  const langList = Object.keys(languages);

  const pageCountByLang: Record<string, number> = {};
  for (const lang of langList) {
    const count = posts.filter((post) => post.id.startsWith(`${lang}/`)).length;
    pageCountByLang[lang] = Math.max(1, Math.ceil(count / siteConfig.blog.postsPerPage));
  }

  return langList.flatMap((lang) => {
      const filteredPosts = posts.filter((post) => post.id.startsWith(`${lang}/`));
      const pages = paginate(filteredPosts, { 
          params: { lang }, 
          pageSize: siteConfig.blog.postsPerPage
      });

      return pages.map((pageObj) => {
        const pageNum = pageObj.props.page.currentPage;
        const availableLangs = langList.filter((l) => pageCountByLang[l] >= pageNum);
        return {
          ...pageObj,
          props: {
            ...pageObj.props,
            availableLangs,
          }
        };
      });
  });
}

interface Props {
  page: Page<CollectionEntry<'blog'>>;
  availableLangs?: string[];
}

const { page, availableLangs } = Astro.props as Props;
const { lang } = Astro.params;
const t = useTranslations(lang);
---

<Layout 
  title="Blog - Astro Boilerplate" 
  description="Read our latest articles"
  availableLangs={availableLangs}
>
  <PageHeader 
      title={t['blog.hero.title']}
      description={t['blog.hero.subtitle']}
  />

  <Container as="section" class="pb-24">
      <Grid cols={3} class="mb-16">
        {page.data.map((post: CollectionEntry<'blog'>) => (
          <BlogCard 
             title={post.data.title}
             description={post.data.description}
             pubDate={post.data.pubDate}
             heroImage={post.data.heroImage}
             slug={`/${lang}/blog/${post.id.split('/').slice(1).join('/').replace(/\.[^/.]+$/, "")}`}
             isVideo={post.data.isVideo}
             author={post.data.author}
             audioUrl={post.data.audioUrl}
          />
        ))}
      </Grid>
      
      <div class="flex items-center justify-center gap-4">
        {page.url.prev && (
            <Button href={page.url.prev} variant="outline" class="gap-2 px-6 py-3 rounded-full bg-white dark:bg-zinc-800">
                ← {t['blog.prev']}
            </Button>
        )}
        
        <span class="text-sm font-bold text-muted-foreground">
            {t['blog.page']} {page.currentPage} {t['blog.of']} {page.lastPage}
        </span>

        {page.url.next && (
            <Button href={page.url.next} variant="outline" class="gap-2 px-6 py-3 rounded-full bg-white dark:bg-zinc-800">
                {t['blog.next']} →
            </Button>
        )}
      </div>
  </Container>
</Layout>
