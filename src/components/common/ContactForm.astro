---
---

<div class="w-full max-w-md mx-auto bg-white/5 p-8 rounded-3xl border border-white/10 backdrop-blur-sm">
  <div id="contact-form-wrapper" class="grid" data-status="idle">
    <div data-view="success" class="[grid-area:1/1] text-center py-12">
      <div class="w-16 h-16 bg-green-500/20 text-green-400 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8" aria-hidden="true">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      </div>
      <h3 class="text-2xl font-bold mb-2">Message Sent!</h3>
      <p class="text-muted-foreground">We'll get back to you as soon as possible.</p>
      <button type="button" id="contact-reset" class="mt-6 text-sm text-primary dark:text-white hover:underline">
        Send another message
      </button>
    </div>

    <form id="contact-form" data-view="form" class="[grid-area:1/1] space-y-4" novalidate>
      <input type="text" name="b_name" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

      <p id="contact-generic-error" class="text-sm text-red-500 hidden">Something went wrong. Please try again.</p>

      <div>
        <label for="name" class="block text-sm font-medium mb-2 text-muted-foreground">
          Name <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          class="field-input w-full px-4 py-3 rounded-xl bg-white dark:bg-white/10 border border-black/10 dark:border-white/10 outline-none transition-all placeholder:text-muted-foreground dark:placeholder:text-white/20 text-foreground dark:text-white focus:border-primary focus:ring-1 focus:ring-primary"
          placeholder="John Doe"
        />
        <p class="field-error mt-1 text-xs text-red-500" data-field="name" hidden></p>
      </div>

      <div>
        <label for="email" class="block text-sm font-medium mb-2 text-muted-foreground">
          Email <span class="text-red-500">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          class="field-input w-full px-4 py-3 rounded-xl bg-white dark:bg-white/5 border border-black/10 dark:border-white/10 outline-none transition-all placeholder:text-muted-foreground dark:placeholder:text-white/20 focus:border-primary focus:ring-1 focus:ring-primary"
          placeholder="john@example.com"
        />
        <p class="field-error mt-1 text-xs text-red-500" data-field="email" hidden></p>
      </div>

      <div>
        <label for="message" class="block text-sm font-medium mb-2 text-muted-foreground">
          Message <span class="text-red-500">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="4"
          class="field-input w-full px-4 py-3 rounded-xl bg-white dark:bg-white/10 border border-black/10 dark:border-white/10 outline-none transition-all placeholder:text-muted-foreground dark:placeholder:text-white/20 text-foreground dark:text-white resize-none focus:border-primary focus:ring-1 focus:ring-primary"
          placeholder="How can we help you?"
        ></textarea>
        <p class="field-error mt-1 text-xs text-red-500" data-field="message" hidden></p>
      </div>

      <button
        type="submit"
        id="contact-submit"
        class="w-full py-4 bg-primary text-primary-foreground font-medium rounded-xl hover:bg-primary/90 transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed mt-2"
      >
        <span class="submit-idle-label flex items-center gap-2">
          Send Message
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
            <path d="m22 2-7 20-4-9-9-4Z" />
            <path d="M22 2 11 13" />
          </svg>
        </span>
        <span class="submit-loading-label hidden items-center gap-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 animate-spin" aria-hidden="true">
            <path d="M21 12a9 9 0 1 1-6.219-8.56" />
          </svg>
          Sending...
        </span>
      </button>
    </form>
  </div>
</div>

<script>
  import { actions, isInputError } from 'astro:actions';

  const wrapper = document.getElementById('contact-form-wrapper');
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const resetBtn = document.getElementById('contact-reset');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const genericError = document.getElementById('contact-generic-error');

  function setStatus(status: 'idle' | 'submitting' | 'success') {
    wrapper?.setAttribute('data-status', status);
  }

  function clearErrors() {
    form?.querySelectorAll<HTMLElement>('.field-error').forEach((el) => {
      el.hidden = true;
      el.textContent = '';
    });
    genericError?.classList.add('hidden');
  }

  function showFieldErrors(fields: Record<string, string[] | undefined>) {
    for (const [key, messages] of Object.entries(fields)) {
      const el = form?.querySelector<HTMLElement>(`[data-field="${key}"]`);
      if (el && messages?.[0]) {
        el.hidden = false;
        el.textContent = messages[0];
      }
    }
  }

  function validateClient(data: FormData) {
    const errors: Record<string, string[]> = {};
    if (!data.get('name')?.toString().trim()) {
      errors.name = ['Name is required'];
    }
    const email = data.get('email')?.toString().trim() ?? '';
    if (!email) {
      errors.email = ['Email is required'];
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errors.email = ['Please enter a valid email address'];
    }
    if (!data.get('message')?.toString().trim()) {
      errors.message = ['Message is required'];
    }
    return errors;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    const formData = new FormData(form);
    const clientErrors = validateClient(formData);
    if (Object.keys(clientErrors).length > 0) {
      showFieldErrors(clientErrors);
      return;
    }

    setStatus('submitting');
    if (submitBtn) submitBtn.disabled = true;

    const { error } = await actions.contact.send(formData);

    if (submitBtn) submitBtn.disabled = false;

    if (error) {
      if (isInputError(error)) {
        showFieldErrors(error.fields);
      } else {
        genericError?.classList.remove('hidden');
      }
      setStatus('idle');
      return;
    }

    setStatus('success');
    form.reset();
  });

  resetBtn?.addEventListener('click', () => setStatus('idle'));
</script>

<style>
  [data-view] {
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  [data-view='success'] {
    opacity: 0;
    transform: scale(0.95);
    pointer-events: none;
  }

  #contact-form-wrapper[data-status='success'] [data-view='success'] {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  #contact-form-wrapper[data-status='success'] [data-view='form'] {
    opacity: 0;
    transform: scale(0.95);
    pointer-events: none;
  }

  #contact-form-wrapper[data-status='submitting'] #contact-form {
    opacity: 0.7;
  }

  #contact-form-wrapper[data-status='submitting'] .submit-idle-label {
    display: none;
  }

  .submit-loading-label {
    display: none;
  }

  #contact-form-wrapper[data-status='submitting'] .submit-loading-label {
    display: flex;
  }

  .field-input[data-invalid='true'] {
    border-color: rgb(239 68 68);
  }
</style>
